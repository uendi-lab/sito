# Example environment variables for production. Copy to .env and fill values.
# Host/port
HOST=0.0.0.0
PORT=1337

# Secrets (replace with secure random values)
# APP_KEYS should be a comma separated array of at least 2 values
APP_KEYS=replace_me_1,replace_me_2
API_TOKEN_SALT=replace_me_api_salt
JWT_SECRET=replace_me_jwt_secret
ADMIN_JWT_SECRET=replace_me_admin_jwt

# Database (Postgres example). You can also set DATABASE_URL instead.
DATABASE_CLIENT=postgres
DATABASE_HOST=your-db-host
DATABASE_PORT=5432
DATABASE_NAME=your_db_name
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
# Alternatively provide a single DATABASE_URL
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# If you require SSL for DB connection
DATABASE_SSL=false

# Upload provider (S3-compatible / Supabase storage)
# If you use an S3-compatible provider, set these. For Supabase storage, see provider docs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Other production tuning
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
